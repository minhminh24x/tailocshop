# =====================================
# TaiLocShop Backend - Environment Variables
# =====================================
# Copy file này thành .env và điền các giá trị thật

# =====================================
# DATABASE
# =====================================
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"

# =====================================
# AUTHENTICATION
# =====================================
# JWT Secret Key - Sử dụng chuỗi ngẫu nhiên mạnh (ít nhất 32 ký tự)
# Có thể tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY="your-super-secret-jwt-key-here"

# =====================================
# EMAIL SERVICE (Gmail SMTP)
# =====================================
# Email dùng để gửi mail (cần bật "Less secure apps" hoặc dùng App Password)
EMAIL_SERVICE="Gmail"
EMAIL_USERNAME=your-email@gmail.com
# App Password từ Google Account Security (16 ký tự, không có khoảng trắng)
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# =====================================
# FRONTEND URL
# =====================================
# URL của frontend (dùng cho CORS và links trong email)
FRONTEND_URL=http://localhost:3000

# =====================================
# OPTIONAL: Production Database
# =====================================
# Uncomment và điền khi deploy lên production
# DATABASE_URL="postgresql://user:password@production-host/database"
