// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// 1. Khai báo Generator cho Prisma Client
generator client {
  provider = "prisma-client-js"
}

// 2. Khai báo Datasource (kết nối CSDL)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 3. Định nghĩa các ENUMs
// (Tương ứng với CREATE TYPE trong SQL)

enum UserRole {
  ADMIN
  STAFF
  SUPPLIER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum CurrencyType {
  USD
  COIN
}

enum ItemUnit {
  PIECE
  STACK
  SHULKER
}

enum StockReason {
  SUPPLIER_SUBMISSION_APPROVED
  ORDER_FULFILLED
  ADMIN_ADJUSTMENT
}

// 4. Định nghĩa các Model (Tương ứng với Bảng)

//==============================================================
// Cụm 1: Quản lý Người dùng và VIP
//==============================================================

model VipLevel {
  level           Int     @id // level là PRIMARY KEY
  name            String  @db.VarChar(100)
  coinThreshold   Decimal @map("coin_threshold") @db.Decimal(12, 2)
  discountPercent Int     @default(0) @map("discount_percent")

  // Quan hệ: Một cấp VIP có nhiều User
  users User[]

  @@map("vip_levels")
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique @db.VarChar(255)
  passwordHash       String   @map("password_hash")
  inGameName         String   @unique @map("in_game_name") @db.VarChar(100)
  role               UserRole @default(CUSTOMER)
  totalSpentCoin     Decimal  @default(0) @map("total_spent_coin") @db.Decimal(12, 2)
  mustChangePassword Boolean  @default(true) @map("must_change_password")

  // [THÊM] Password Reset Fields
  passwordResetToken  String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpiry DateTime? @map("password_reset_expiry") @db.Timestamptz

  // Quan hệ với VipLevel
  vipLevelInt Int      @default(0) @map("vip_level")
  vipLevel    VipLevel @relation(fields: [vipLevelInt], references: [level])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Quan hệ ngược (Back-relations)
  updatedExchangeRates CurrencyExchangeRate[]
  orders               Order[]                @relation("CustomerOrders") // Đơn hàng của Customer
  handledOrders        Order[]                @relation("StaffHandledOrders") // Đơn hàng Staff xử lý
  inventoryLogs        InventoryLog[]
  supplierSubmissions  SupplierSubmission[]   @relation("SupplierSubmissions") // Phiếu Supplier tạo
  approvedSubmissions  SupplierSubmission[]   @relation("AdminApprovedSubmissions") // Phiếu Admin duyệt
  
  // [THÊM] Phase 3 relations
  wishlists            Wishlist[]
  reviews              Review[]

  @@index([inGameName])
  @@map("users")
}

//==============================================================
// Cụm 2: Quản lý Vật phẩm, Danh mục và Tỷ giá
//==============================================================

model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(255)
  slug String @unique @db.VarChar(255)

  // Quan hệ tự tham chiếu (Parent-Child)
  parentId String?    @map("parent_id") @db.Uuid
  parent   Category?  @relation("ParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("ParentChild")

  // Quan hệ: Một danh mục có nhiều Item
  items Item[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz // <-- ĐÃ SỬA
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz // <-- ĐÃ SỬA

  @@map("categories")
}

model Item {
  id String @id @default(uuid()) @db.Uuid

  // Quan hệ với Category
  categoryId String?   @map("category_id") @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name              String   @db.VarChar(255)
  slug              String   @db.VarChar(255) // Ràng buộc unique được dời xuống @@unique
  description       String?
  thumbnailImageUrl String?  @map("thumbnail_image_url")
  unit              ItemUnit @default(PIECE)

  priceUsd  Decimal? @map("price_usd") @db.Decimal(12, 2)
  priceCoin Decimal? @map("price_coin") @db.Decimal(12, 2)

  stockQuantity Int     @default(0) @map("stock_quantity")
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz // <-- ĐÃ SỬA
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz // <-- ĐÃ SỬA

  // Quan hệ ngược
  orderDetails              OrderDetail[]
  inventoryLogs             InventoryLog[]
  supplierSubmissionDetails SupplierSubmissionDetail[]
  
  // [THÊM] Phase 3 relations
  wishlists                 Wishlist[]
  reviews                   Review[]

  @@unique([slug, unit]) // UNIQUE(slug, unit)
  @@index([categoryId])
  @@index([slug])
  @@map("items")
}

model CurrencyExchangeRate {
  id       String  @id @default(uuid()) @db.Uuid
  rate     Decimal @db.Decimal(15, 2)
  rateType String  @unique @map("rate_type") @db.VarChar(50)

  // Quan hệ với User (Admin cập nhật)
  updatedById String? @map("updated_by") @db.Uuid
  updatedBy   User?   @relation(fields: [updatedById], references: [id])

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz // <-- ĐÃ SỬA

  @@map("currency_exchange_rates")
}

//==============================================================
// Cụm 3: Quản lý Đơn hàng (Orders)
//==============================================================

model DeliveryTimeSlot {
  id          String  @id @default(uuid()) @db.Uuid
  displayText String  @map("display_text") @db.VarChar(100)
  isActive    Boolean @default(true) @map("is_active")

  // New fields
  dayOfWeek Int    @default(0) @map("day_of_week")
  startTime String @default("00:00") @map("start_time") @db.VarChar(5)
  endTime   String @default("23:59") @map("end_time") @db.VarChar(5)

  // Quan hệ: Một khung giờ có nhiều Order
  orders Order[]

  @@map("delivery_time_slots")
}

model Order {
  id String @id @default(uuid()) @db.Uuid

  orderNumber String? @unique @map("order_number")

  customerUserId String? @map("customer_user_id") @db.Uuid
  customer       User?   @relation("CustomerOrders", fields: [customerUserId], references: [id], onDelete: SetNull)

  inGameName String @map("in_game_name") @db.VarChar(100)

  staffUserId String? @map("staff_user_id") @db.Uuid
  staff       User?   @relation("StaffHandledOrders", fields: [staffUserId], references: [id], onDelete: SetNull)

  deliveryTimeSlotId String           @map("delivery_time_slot_id") @db.Uuid
  deliveryTimeSlot   DeliveryTimeSlot @relation(fields: [deliveryTimeSlotId], references: [id], onDelete: Restrict)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")

  // [BỎ] Không dùng trường này nữa vì đơn hàng có thể có 2 loại tiền
  // currencyUsed       CurrencyType   @map("currency_used") 

  // [SỬA] Tách riêng các giá trị COIN
  subTotalCoin          Decimal @default(0) @map("sub_total_coin") @db.Decimal(12, 2)
  vipDiscountAmountCoin Decimal @default(0) @map("vip_discount_amount_coin") @db.Decimal(12, 2)
  totalAmountCoin       Decimal @default(0) @map("total_amount_coin") @db.Decimal(12, 2)

  // [THÊM] Tách riêng các giá trị USD
  subTotalUsd    Decimal @default(0) @map("sub_total_usd") @db.Decimal(12, 2)
  // (Chúng ta giả định VIP discount chỉ áp dụng cho COIN)
  totalAmountUsd Decimal @default(0) @map("total_amount_usd") @db.Decimal(12, 2)

  notes     String?
  
  // [THÊM] Order Status Timeline - Track thời điểm mỗi trạng thái
  pendingAt           DateTime? @map("pending_at") @db.Timestamptz
  preparingAt         DateTime? @map("preparing_at") @db.Timestamptz
  readyForDeliveryAt  DateTime? @map("ready_for_delivery_at") @db.Timestamptz
  completedAt         DateTime? @map("completed_at") @db.Timestamptz
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Quan hệ ngược
  orderDetails  OrderDetail[]
  inventoryLogs InventoryLog[]

  @@index([customerUserId])
  @@index([status])
  @@map("orders")
}

model OrderDetail {
  id String @id @default(uuid()) @db.Uuid

  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemId String @map("item_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity       Int
  unitAtPurchase ItemUnit @map("unit_at_purchase")

  // [SỬA] Thêm trường tiền tệ cho từng dòng
  currencyAtPurchase CurrencyType @default(COIN) @map("currency_at_purchase")

  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(12, 2)
  totalLineAmount Decimal @map("total_line_amount") @db.Decimal(12, 2)

  @@map("order_details")
}

//==============================================================
// Cụm 4: Quản lý Kho (Inventory) và Phiếu nhập từ Supplier
//==============================================================

model InventoryLog {
  id String @id @default(uuid()) @db.Uuid

  // Quan hệ với Item
  itemId String @map("item_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Quan hệ với User (Admin/Staff)
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Quan hệ với Order (Nullable)
  orderId String? @map("order_id") @db.Uuid
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  quantityChange   Int         @map("quantity_change")
  newStockQuantity Int         @map("new_stock_quantity")
  reason           StockReason
  notes            String?
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz // <-- ĐÃ SỬA

  @@map("inventory_logs")
}

model SupplierSubmission {
  id String @id @default(uuid()) @db.Uuid

  // Quan hệ với User (Supplier)
  supplierUserId String @map("supplier_user_id") @db.Uuid
  supplier       User   @relation("SupplierSubmissions", fields: [supplierUserId], references: [id], onDelete: Restrict)

  status String @default("PENDING") @db.VarChar(50)

  // Quan hệ với User (Admin/Staff duyệt)
  approvedByUserId String? @map("approved_by_user_id") @db.Uuid
  approvedBy       User?   @relation("AdminApprovedSubmissions", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  supplierNotes  String? @map("supplier_notes")
  adminNotes     String? @map("admin_notes")
  totalValueCoin Decimal @default(0) @map("total_value_coin") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz // <-- ĐÃ SỬA
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz // <-- ĐÃ SỬA

  // Quan hệ ngược
  supplierSubmissionDetails SupplierSubmissionDetail[]

  @@index([supplierUserId])
  @@index([status])
  @@map("supplier_submissions")
}

model SupplierSubmissionDetail {
  id String @id @default(uuid()) @db.Uuid

  // Quan hệ với SupplierSubmission
  submissionId String             @map("submission_id") @db.Uuid
  submission   SupplierSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Quan hệ với Item
  itemId String @map("item_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity                  Int
  unit                      ItemUnit
  suggestedPricePerUnitCoin Decimal  @map("suggested_price_per_unit_coin") @db.Decimal(12, 2)
  finalPricePerUnitCoin     Decimal  @map("final_price_per_unit_coin") @db.Decimal(12, 2)

  @@map("supplier_submission_details")
}

//==============================================================
// Cụm 5: Phase 3 - Enhancement Features
//==============================================================

// Wishlist - Danh sách yêu thích
model Wishlist {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String @map("item_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, itemId]) // Mỗi user chỉ có thể thêm 1 item 1 lần
  @@index([userId])
  @@map("wishlists")
}

// Review - Đánh giá sản phẩm
model Review {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String @map("item_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  rating  Int    // 1-5 sao
  comment String? @db.Text

  isApproved Boolean @default(false) @map("is_approved") // Admin duyệt review

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, itemId]) // Mỗi user chỉ review 1 item 1 lần
  @@index([itemId])
  @@index([isApproved])
  @@map("reviews")
}

// Voucher - Mã giảm giá
model Voucher {
  id String @id @default(uuid()) @db.Uuid

  code        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  
  discountType   VoucherDiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue  Decimal @map("discount_value") @db.Decimal(12, 2) // % hoặc số tiền
  
  minOrderValue  Decimal? @map("min_order_value") @db.Decimal(12, 2) // Giá trị đơn hàng tối thiểu
  maxDiscount    Decimal? @map("max_discount") @db.Decimal(12, 2) // Giảm tối đa (cho %)
  
  usageLimit     Int?     @map("usage_limit") // Số lần sử dụng tối đa
  usedCount      Int      @default(0) @map("used_count") // Số lần đã sử dụng
  
  isActive       Boolean  @default(true) @map("is_active")
  startDate      DateTime? @map("start_date") @db.Timestamptz
  endDate        DateTime? @map("end_date") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([code])
  @@index([isActive])
  @@map("vouchers")
}

enum VoucherDiscountType {
  PERCENTAGE // Giảm theo %
  FIXED_COIN // Giảm số xu cố định
}
